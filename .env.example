NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce
UPSTASH_REDIS_URL=redis://127.0.0.1:6379

# Replace both placeholders with distinct, randomly generated secrets of at least 32 bytes.
JWE_SECRET=replace-with-a-random-access-secret-of-at-least-32-bytes
JWE_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-of-at-least-32-bytes
JWE_ACCESS_EXPIRATION=15m
JWE_REFRESH_EXPIRATION=7d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Stripe test-mode credentials only. Never use live keys in this application.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
