NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce_demo
UPSTASH_REDIS_URL=redis://127.0.0.1:6379

JWE_SECRET=replace-with-at-least-32-random-characters
JWE_REFRESH_SECRET=replace-with-another-32-random-characters
JWE_ACCESS_EXPIRATION=15m
JWE_REFRESH_EXPIRATION=7d

CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Test-mode keys only. Live Stripe keys are rejected during startup.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
