{
  "name": "e-commerce-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon back-end/server.js",
    "dev:client": "npm run dev --prefix front-end",
    "start": "node back-end/server.js",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "eslint back-end scripts tests",
    "lint:client": "npm run lint --prefix front-end",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test tests/project-quality.test.js tests/config.test.js tests/api-foundation.test.js tests/server-lifecycle.test.js tests/authentication.test.js tests/session-security.test.js",
    "test:client": "npm run test --prefix front-end",
    "build": "npm run build:server && npm run build:client",
    "build:server": "node scripts/check-server-syntax.js",
    "build:client": "npm run build --prefix front-end",
    "seed": "node back-end/seedProducts.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "jose": "^6.2.3",
    "mongoose": "^8.16.3",
    "stripe": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "nodemon": "^3.1.14"
  }
}
